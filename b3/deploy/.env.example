# --- Indexer + agent-runtime ---
BASE_RPC_URL=https://mainnet.base.org
AGENT_BASE_RPC_URL=https://mainnet.base.org
AGENT_CHAIN_ID=8453
# INDEX_FROM_BLOCK=0

# Kill-switch and economics (see docs/TREASURY_POLICY.md)
AGENTS_PAUSED=1
ECON_LIVE=0

# Bootstrap while 0G bridge unfunded — see docs/AGENT_BOOTSTRAP_MODE.md
