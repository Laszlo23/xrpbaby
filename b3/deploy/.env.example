# =============================================================================
# deploy/.env — used by docker compose AND copied into app/.env for builds
# =============================================================================
# Copy: cp deploy/.env.example deploy/.env
# Never commit deploy/.env.
#
# After an operator redeploys contracts, sync addresses from:
#   b3/contracts/deployments/8453.json
# then run from b3/:  npm run contracts:sdk
# and refresh the VITE_* lines below before rebuilding the web image.
# See also: deploy/POST_REDEPLOY_SYNC.md

# --- Postgres (compose + Prisma + Strapi) ---
POSTGRES_USER=buildingculture
POSTGRES_PASSWORD=change-me
POSTGRES_DB=buildingculture
POSTGRES_PORT=5432

# Single URL for app DB (Prisma). Strapi uses DATABASE_* below as well.
DATABASE_URL=postgresql://buildingculture:change-me@postgres:5432/buildingculture?schema=public

# --- Image tags (optional overrides) ---
# STRAPI_IMAGE=buildingculture-strapi:latest
# WEB_IMAGE=buildingculture-frontend:latest
# AGENT_RUNTIME_IMAGE=buildingculture-agent-runtime:latest
# INDEXER_IMAGE=buildingculture-indexer:latest

# --- Strapi (container env) ---
HOST=0.0.0.0
PORT=1337
NODE_ENV=production
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=

DATABASE_CLIENT=postgres
# Redundant with DATABASE_URL but explicit for operators:
# DATABASE_HOST=postgres
# DATABASE_PORT=5432
# DATABASE_NAME=buildingculture
# DATABASE_USERNAME=buildingculture
# DATABASE_PASSWORD=change-me

# Comma-separated browser origins allowed to call Strapi (required in production)
CORS_ORIGIN=https://app.buildingcultureid.space,https://0x.buildingcultureid.space,https://bcdai.buildingcultureid.space,https://ankommen.buildingcultureid.space,https://forkids.buildingcultureid.space

# SIWE / wallet auth for community profiles
SIWE_ALLOWED_DOMAINS=app.buildingcultureid.space,0x.buildingcultureid.space,bcdai.buildingcultureid.space,ankommen.buildingcultureid.space,forkids.buildingcultureid.space,studio.buildingcultureid.space

# BC Studio — sandbox orchestrator on VPS (http://HOST:8790)
STUDIO_SANDBOX_HOST=http://127.0.0.1:8790
STUDIO_SANDBOX_SECRET=change-me-studio-secret
STUDIO_PREVIEW_ORIGIN=https://app.buildingcultureid.space
# CreateOS publish (phase 2)
CREATEOS_API_BASE=
CREATEOS_API_KEY=
WALLET_AUTH_CHAIN_IDS=8453

# Neynar — Farcaster SIWN + social score sync
# NEYNAR_API_KEY=
# NEYNAR_CLIENT_ID=
# VITE_NEYNAR_CLIENT_ID=
# NEYNAR_SCORE_MIN=0
# PLATFORM_INTERNAL_SECRET=   # founding app → hub Farcaster bridge
# HUB_API_ORIGIN=https://app.buildingcultureid.space

# --- Frontend / SSR (web container + Vite build args) ---
# VITE_* are baked at `docker build` time — set before running app/scripts/docker-build.sh
VITE_BASE_RPC_URL=https://mainnet.base.org
VITE_EVM_CHAIN_ID=8453

# Current curated Base mainnet deployment (sync with contracts/deployments/8453.json)
VITE_BCC_TOKEN_ADDRESS=0xb890a5289f789f1346032ccc1847939e855fab07
VITE_BCC_UNISWAP_URL=https://app.uniswap.org/swap?outputCurrency=0xB890a5289F789f1346032Ccc1847939e855FAb07&chain=base
VITE_BCC_DISCOUNT_BPS=1111
# Aerodrome secondary BCC/WETH pool (Base) — see docs/BCC_AERODROME_LIQUIDITY.md
# Enable deposit/swap links before pool is live; run: npm run aerodrome:resolve -- --write
VITE_BCC_AERODROME_ENABLED=1
# Primary Uniswap V3 pool (DexScreener) — optional deep link
VITE_BCC_UNISWAP_POOL=0xbb1a4e26d908a8fdddcea5d634faaa47eb8959b78384af66fea0bf45732143fb
# Set after pool exists on Aerodrome (resolve script fills these when listed)
# VITE_BCC_AERODROME_POOL=
# VITE_BCC_AERODROME_LP_TOKEN=
# VITE_BCC_AERODROME_GAUGE=
# Points → BCC redemption (off until combined TVL ≥ $500k and ops enables)
# VITE_POINTS_REDEEM_ENABLED=0
# VITE_POINTS_PER_BCC_WEI=
# Panic Switch on-chain daily reward (optional; falls back to queued settlement when disabled)
# PANIC_SWITCH_BCC_REWARD_ONCHAIN=1
# PANIC_SWITCH_BCC_REWARD_PRIVATE_KEY=0x...
# PANIC_SWITCH_BCC_REWARD_CHAIN_ID=8453
# PANIC_SWITCH_BCC_REWARD_RPC_URL=https://mainnet.base.org
# PANIC_SWITCH_BCC_REWARD_TOKEN_ADDRESS=0xb890a5289f789f1346032ccc1847939e855fab07
# PANIC_SWITCH_BCC_REWARD_WEI=77000000000000000
VITE_BCD_TOKEN_ADDRESS=0xb890a5289f789f1346032ccc1847939e855fab07
VITE_BCD_LEGACY_TOKEN_ADDRESS=0xda64dceb00b88ee1b8f6168beb58f5a2a7226b72
VITE_BCD_GENESIS_CLAIM_ADDRESS=0x2bae6b04d0d1c8016cc863509395b68eb0021f58
