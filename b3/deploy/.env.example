# OG_COMPUTE_DIRECT_API_KEY=app-sk-...
# OG_COMPUTE_DIRECT_PROVIDER=0x...
# SOCIAL_SCOUT_AUTO_POST=0

# Slack digest (optional)
# SLACK_WEBHOOK_URL=

# Intervals (seconds)
AGENT_TICK_INTERVAL_SEC=900
INDEXER_INTERVAL_SEC=300

