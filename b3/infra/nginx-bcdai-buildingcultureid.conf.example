# BCDAI satellite — reverse proxy to Google Cloud Run
# Canonical URL: https://bcdai.buildingcultureid.space/
# Upstream: bcdai-573598326867.europe-west2.run.app
#
# Alternative: map the custom domain in GCP Cloud Run (Manage custom domains)
# and skip nginx — prefer Cloud Run domain mapping when possible.
#
# DNS: CNAME bcdai.buildingcultureid.space → your nginx host or Cloud Run mapping target
# TLS: certbot certonly --nginx -d bcdai.buildingcultureid.space

upstream bcdai_cloud_run {
    server bcdai-573598326867.europe-west2.run.app:443;
    keepalive 8;
}

server {
    listen 80;
    listen [::]:80;
    server_name bcdai.buildingcultureid.space;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name bcdai.buildingcultureid.space;

    ssl_certificate /etc/letsencrypt/live/bcdai.buildingcultureid.space/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bcdai.buildingcultureid.space/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 20m;

    location / {
        proxy_pass https://bcdai_cloud_run;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host bcdai-573598326867.europe-west2.run.app;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
    }
}
