{
  "name": "ankommen",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @ankommen/database generate",
    "db:migrate": "pnpm --filter @ankommen/database migrate:dev",
    "db:seed": "pnpm --filter @ankommen/database seed",
    "db:studio": "pnpm --filter @ankommen/database studio",
    "chain:deploy": "pnpm --filter @ankommen/chain deploy:local"
  },
  "devDependencies": {
    "prettier": "^3.7.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.2.0",
      "@types/react-dom": "^19.2.0"
    }
  }
}
