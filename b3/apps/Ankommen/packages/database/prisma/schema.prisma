generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  USER
  PREMIUM_USER
  NGO_PARTNER
  ADMIN
}

enum AgentType {
  AUSTRIA_GUIDE
  BENEFITS
  HOUSING
  DOCUMENT
  JOBS_AMS
  HEALTHCARE
  SCHOOL_FAMILY
  TRANSLATION
  TOURIST_LONGSTAY
  NEARBY_HELP
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  INCOMPLETE
}

enum PaymentProvider {
  STRIPE
  APPLE
  GOOGLE
  MANUAL
  BCC
}

enum IdentityTier {
  GUEST
  WALLET
  EID_VERIFIED
}

enum SettlementStatus {
  NONE
  PENDING
  CONFIRMED
  ESCROWED
  FAILED
}

enum DocumentStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum NotificationType {
  REMINDER
  SUBSCRIPTION
  DOCUMENT
  SYSTEM
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          Role      @default(USER)
  isGuest       Boolean   @default(false)
  guestDeviceId String?   @unique
  stripeCustomerId String? @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  accounts         Account[]
  sessions         Session[]
  profile          Profile?
  languagePref     LanguagePreference?
  subscriptions    Subscription[]
  payments         Payment[]
  conversations    Conversation[]
  documents        UploadedDocument[]
  benefitChecks    BenefitCheck[]
  housingSearches  HousingSearch[]
  savedPlaces      SavedPlace[]
  notifications    Notification[]
  walletAccounts   WalletAccount[]
  bccEscrow        BccEscrow?
  partnerUsers     PartnerUser[]      @relation("SupportedUsers")
  supportedBy      PartnerUser[]      @relation("PartnerUsers")

  @@index([email])
  @@index([guestDeviceId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model WalletAccount {
  id        String   @id @default(cuid())
  userId    String
  address   String   @unique
  chain     String   @default("austria")
  chainId   Int      @default(7777777)
  isPrimary Boolean  @default(true)
  linkedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BccEscrow {
  id        String   @id @default(cuid())
  userId    String   @unique
  amount    Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  preferredLang   String   @default("en")
  city            String?
  state           String?
  postalCode      String?
  nationality     String?
  residenceStatus String?
  familyStatus    String?
  hasChildren     Boolean  @default(false)
  childrenCount   Int      @default(0)
  workStatus      String?
  housingStatus   String?
  mainGoal        String?
  onboardingDone  Boolean  @default(false)
  checklist       Json     @default("[]")
  aiMemoryEnabled Boolean      @default(true)
  analyticsOptOut Boolean      @default(false)
  identityTier    IdentityTier @default(GUEST)
  eidSubjectHash  String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LanguagePreference {
  id           String   @id @default(cuid())
  userId       String   @unique
  interfaceLang String  @default("en")
  chatLang     String   @default("en")
  translateFrom String  @default("de")
  translateTo  String   @default("en")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Plan {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  description     String?
  priceMonthly    Int      @default(0)
  priceYearly     Int      @default(0)
  currency        String   @default("EUR")
  aiMessagesLimit Int?
  documentLimit   Int?
  features        Json     @default("[]")
  stripePriceId     String?
  appleProductId    String?
  googleProductId   String?
  bccGrantPerMonth  Int?
  bccGrantOnSignup  Int?
  bccRenewalPrice   Int?
  isActive          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  planId               String
  status               SubscriptionStatus @default(ACTIVE)
  provider             PaymentProvider    @default(STRIPE)
  stripeSubscriptionId String?            @unique
  appleReceiptRef      String?
  googlePurchaseToken  String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  familyMemberIds      Json               @default("[]")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([userId])
  @@index([status])
}

model Payment {
  id               String           @id @default(cuid())
  userId           String
  subscriptionId   String?
  amount           Int
  currency         String           @default("EUR")
  provider         PaymentProvider
  providerRef      String?
  status           String           @default("succeeded")
  bccAmount        Int?
  bccTxHash        String?
  settlementStatus SettlementStatus @default(NONE)
  exchangeRate     String?
  createdAt        DateTime         @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([userId])
  @@index([providerRef])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String?
  agentType AgentType @default(AUSTRIA_GUIDE)
  language  String    @default("en")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  role           String
  content        String    @db.Text
  agentType      AgentType?
  citations      Json      @default("[]")
  tokenUsage     Int       @default(0)
  confidence     Float?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model UploadedDocument {
  id           String         @id @default(cuid())
  userId       String
  fileName     String
  mimeType     String
  fileSize     Int
  s3Key        String
  status       DocumentStatus @default(UPLOADING)
  ocrText      String?        @db.Text
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis DocumentAnalysis?

  @@index([userId])
}

model DocumentAnalysis {
  id             String   @id @default(cuid())
  documentId     String   @unique
  summary        String   @db.Text
  deadlines      Json     @default("[]")
  requiredAction String?  @db.Text
  riskLevel      String?
  officeInvolved String?
  nextSteps      Json     @default("[]")
  draftLetter    String?  @db.Text
  disclaimer     String   @db.Text
  createdAt      DateTime @default(now())

  document UploadedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model BenefitCheck {
  id          String   @id @default(cuid())
  userId      String
  answers     Json
  results     Json
  disclaimer  String   @db.Text
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model HousingSearch {
  id        String   @id @default(cuid())
  userId    String
  query     Json
  results   Json     @default("[]")
  saved     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SavedPlace {
  id        String   @id @default(cuid())
  userId    String
  officeId  String?
  ngoId     String?
  notes     String?
  createdAt DateTime @default(now())

  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  office GovernmentOffice? @relation(fields: [officeId], references: [id])
  ngo    NGO?              @relation(fields: [ngoId], references: [id])

  @@index([userId])
}

model ServiceCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  icon        String?
  sortOrder   Int      @default(0)

  offices GovernmentOffice[]
  ngos    NGO[]
}

model GovernmentOffice {
  id           String   @id @default(cuid())
  categoryId   String
  name         String
  description  String?  @db.Text
  address      String
  city         String
  state        String   @default("Wien")
  postalCode   String?
  latitude     Float?
  longitude    Float?
  phone        String?
  email        String?
  website      String?
  openingHours Json?
  languages    Json     @default("[]")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category    ServiceCategory @relation(fields: [categoryId], references: [id])
  savedPlaces SavedPlace[]

  @@index([city])
  @@index([categoryId])
}

model NGO {
  id           String   @id @default(cuid())
  categoryId   String
  name         String
  description  String?  @db.Text
  address      String
  city         String
  state        String   @default("Wien")
  postalCode   String?
  latitude     Float?
  longitude    Float?
  phone        String?
  email        String?
  website      String?
  openingHours Json?
  languages    Json     @default("[]")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category    ServiceCategory @relation(fields: [categoryId], references: [id])
  savedPlaces SavedPlace[]

  @@index([city])
}

model KnowledgeSource {
  id              String    @id @default(cuid())
  title           String
  url             String?
  sourceType      String    @default("web")
  content         String    @db.Text
  chunkIndex      Int       @default(0)
  parentId        String?
  lastSyncedAt    DateTime?
  confidenceScore Float     @default(0.8)
  isVerified      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  parent KnowledgeSource?  @relation("KnowledgeChunks", fields: [parentId], references: [id])
  chunks KnowledgeSource[] @relation("KnowledgeChunks")

  @@index([parentId])
  @@index([url])
}

model KnowledgeEmbedding {
  id        String                       @id @default(cuid())
  sourceId  String                       @unique
  embedding Unsupported("vector(2560)")?

  @@map("knowledge_embeddings")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  read      Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AdminLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  target    String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
}

model PartnerUser {
  id            String   @id @default(cuid())
  partnerId     String
  supportedId   String
  notes         String?
  createdAt     DateTime @default(now())

  partner   User @relation("PartnerUsers", fields: [partnerId], references: [id], onDelete: Cascade)
  supported User @relation("SupportedUsers", fields: [supportedId], references: [id], onDelete: Cascade)

  @@unique([partnerId, supportedId])
}

model Referral {
  id         String   @id @default(cuid())
  code       String   @unique
  userId     String?
  platform   String   @default("farcaster")
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())
}
