# Monorepo-aware Places build. Context: repo root slice containing `packages/` + `apps/places/web/`.
# scripts/deploy-places-production.sh rsyncs those paths to the server before building.
FROM node:20-bookworm-slim AS deps
WORKDIR /repo
COPY packages/bcc-kit packages/bcc-kit
COPY packages/culture-auth packages/culture-auth
COPY apps/places/web/package.json apps/places/web/package-lock.json apps/places/web/
WORKDIR /repo/apps/places/web
RUN npm ci

FROM node:20-bookworm-slim AS builder
WORKDIR /repo/apps/places/web
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /repo/packages /repo/packages
COPY --from=deps /repo/apps/places/web/node_modules ./node_modules
COPY apps/places/web/ ./
COPY apps/places/data /repo/apps/places/data

ARG NEXT_PUBLIC_SITE_URL=https://places.buildingcultureid.space
ENV NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}
ARG NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID
ENV NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=${NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID}
ARG NEXT_PUBLIC_BASE_RPC
ENV NEXT_PUBLIC_BASE_RPC=${NEXT_PUBLIC_BASE_RPC}
ARG NEXT_PUBLIC_BASE_EXPLORER
ENV NEXT_PUBLIC_BASE_EXPLORER=${NEXT_PUBLIC_BASE_EXPLORER}
ARG NEXT_PUBLIC_BASE_REGISTRY
ENV NEXT_PUBLIC_BASE_REGISTRY=${NEXT_PUBLIC_BASE_REGISTRY}
ARG NEXT_PUBLIC_BASE_SHARE_FACTORY
ENV NEXT_PUBLIC_BASE_SHARE_FACTORY=${NEXT_PUBLIC_BASE_SHARE_FACTORY}
ARG NEXT_PUBLIC_BASE_COMPLIANCE_REGISTRY
ENV NEXT_PUBLIC_BASE_COMPLIANCE_REGISTRY=${NEXT_PUBLIC_BASE_COMPLIANCE_REGISTRY}
ARG NEXT_PUBLIC_BASE_WETH
ENV NEXT_PUBLIC_BASE_WETH=${NEXT_PUBLIC_BASE_WETH}
ARG NEXT_PUBLIC_BASE_ROUTER
ENV NEXT_PUBLIC_BASE_ROUTER=${NEXT_PUBLIC_BASE_ROUTER}
ARG NEXT_PUBLIC_BASE_LENDING_POOL
ENV NEXT_PUBLIC_BASE_LENDING_POOL=${NEXT_PUBLIC_BASE_LENDING_POOL}
ARG NEXT_PUBLIC_BASE_PREDICTION_MARKET
ENV NEXT_PUBLIC_BASE_PREDICTION_MARKET=${NEXT_PUBLIC_BASE_PREDICTION_MARKET}
ARG NEXT_PUBLIC_BASE_PROOF_NFT
ENV NEXT_PUBLIC_BASE_PROOF_NFT=${NEXT_PUBLIC_BASE_PROOF_NFT}
ARG NEXT_PUBLIC_BASE_STAKING
ENV NEXT_PUBLIC_BASE_STAKING=${NEXT_PUBLIC_BASE_STAKING}
ARG NEXT_PUBLIC_BASE_PLATFORM_TOKEN
ENV NEXT_PUBLIC_BASE_PLATFORM_TOKEN=${NEXT_PUBLIC_BASE_PLATFORM_TOKEN}
ARG NEXT_PUBLIC_BASE_PURCHASE_ESCROW_ERC20
ENV NEXT_PUBLIC_BASE_PURCHASE_ESCROW_ERC20=${NEXT_PUBLIC_BASE_PURCHASE_ESCROW_ERC20}
ARG NEXT_PUBLIC_PRIVY_APP_ID
ENV NEXT_PUBLIC_PRIVY_APP_ID=${NEXT_PUBLIC_PRIVY_APP_ID}
ARG NEXT_PUBLIC_PRIVY_CLIENT_ID
ENV NEXT_PUBLIC_PRIVY_CLIENT_ID=${NEXT_PUBLIC_PRIVY_CLIENT_ID}

RUN npm run build

FROM node:20-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
COPY --from=builder /repo/apps/places/web/public ./public
COPY --from=builder --chown=nextjs:nodejs /repo/apps/places/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /repo/apps/places/web/.next/static ./.next/static
USER nextjs
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
CMD ["node", "server.js"]
