# Database
DATABASE_URL="file:./dev.db"

# Solana (client-safe — VITE_ prefix ships to browser)
VITE_SOLANA_NETWORK=devnet
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_BCC_MINT=

# Solana (server-only — never prefix with VITE_)
# Treasury keypair (JSON byte array or base58). Funds proof anchor memo txs on devnet.
# Run: bun run setup:devnet — then paste TREASURY_SECRET_KEY from output.
TREASURY_SECRET_KEY=

# Stripe (server-only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APP_URL=http://localhost:8080

# Proof verification: members build a composite score (mood + journal + deliverables).
# Score >= 60 → eligible. Link wallet on Proof wall, sign, anchor via on-chain memo tx.
# Treasury/bounty payouts require anchored proof for the period (see treasury-gate.server.ts).
