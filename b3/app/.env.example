# VITE_PRIVY_CLIENT_ID=
# Server-only (wallet sync + checkout auth):
# PRIVY_APP_ID=          # same as VITE_PRIVY_APP_ID
# PRIVY_APP_SECRET=      # Privy dashboard → app settings
# Mobile (Capacitor shell + PWA) — configure in Privy dashboard → Allowed origins:
#   https://app.buildingcultureid.space, capacitor://localhost, https://localhost
# Deep-link auth return (optional): buildingculture://auth/callback
# See b3/docs/MOBILE_APP.md

