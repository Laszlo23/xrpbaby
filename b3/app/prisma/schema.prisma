generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Cached Web3.bio identity graph enrichment keyed by wallet owner.
model IdentityEnrichmentCache {
  id        String   @id @default(cuid())
  owner     String   @unique
  fullName  String?
  payload   Json
  fetchedAt DateTime @default(now())
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

/// Unified platform member (wallet-first; optional email / Farcaster).
model Member {
  id            String   @id @default(cuid())
  privyUserId   String?  @unique
  walletAddress String?  @unique
  farcasterFid  Int?     @unique
  email         String?  @unique
  displayName   String?
  intent        String?  // explore | build | gather
  supporterTier String   @default("community") // community | founding | elder
  forestStage   String   @default("seedling") // seedling | sapling | tree | grove
  farcasterUsername String?
  neynarScore       Float?
  supportScore      Int?
  supportScoreMeta  Json?
  socialSyncedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  wallet        Wallet?         @relation(fields: [walletId], references: [id])
  walletId      String?         @unique
  activities      ActivityEvent[]
  rewardGrants    RewardGrant[]
  socialComments  SocialComment[]
  packPurchases   PackPurchase[]
  bccSettlements  BccSettlement[]
  panicVoucherClaims PanicVoucherClaim[]
  socialAccounts  SocialAccount[]
  studioProjects  StudioProject[]
  studioUsages    StudioUsage[]
  quidliDeliveries QuidliDelivery[]
  growthSessions  GrowthSession[]
  productFeedback ProductFeedback[]
  cultureIdentity CultureIdentity?
  userCredentials UserCredential[]
  bcidIdentity    BcidIdentity?
  groveLinksSent     CultureGroveLink[] @relation("GroveInviter")
  groveLinkReceived  CultureGroveLink?  @relation("GroveInvitee")
  groveTwinBloomClaim GroveTwinBloomNftClaim?
  powerState          MemberPowerState?
  powerProofs         MemberPowerProof[]
}

/// Viral grove tree — who invited whom (deduped per invitee).
model CultureGroveLink {
  id              String   @id @default(cuid())
  inviterMemberId String
  inviteeMemberId String   @unique
  agentRef        String?
  dnaHue          Int      @default(160)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  inviter Member @relation("GroveInviter", fields: [inviterMemberId], references: [id], onDelete: Cascade)
  invitee Member @relation("GroveInvitee", fields: [inviteeMemberId], references: [id], onDelete: Cascade)

  @@index([inviterMemberId, createdAt(sort: Desc)])
}

/// Server-minted Twin Bloom audio NFT (2 direct grove invites).
model GroveTwinBloomNftClaim {
  id              String    @id @default(cuid())
  memberId        String    @unique
  member          Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  walletId        String    @unique
  wallet          Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  claimDigest     String    @unique
  status          String    @default("pending")
  chainId         Int?
  contractAddress String?
  txHash          String?
  tokenId         String?
  createdAt       DateTime  @default(now())
  mintedAt        DateTime?

  @@index([status])
  @@index([createdAt(sort: Desc)])
}

/// Linked social identity (Farcaster-verified X/TikTok/GitHub or direct Farcaster link).
model SocialAccount {
  id         String   @id @default(cuid())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  platform   String   // farcaster | x | tiktok | github
  handle     String?
  externalId String?
  verified   Boolean  @default(false)
  source     String   @default("neynar") // neynar | privy | manual
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([memberId, platform])
  @@index([platform, handle])
}

model Wallet {
  id        String   @id @default(cuid())
  address   String   @unique
  createdAt DateTime @default(now())

  member         Member?
  ledgers        PointLedger[]
  airdropAllocs  AirdropAllocation[]
  panicVoucherClaims PanicVoucherClaim[]
  groveTwinBloomClaim GroveTwinBloomNftClaim?
  pointRedemptions PointRedemption[]
  quidliDeliveries QuidliDelivery[]
}

model PointLedger {
  id        String   @id @default(cuid())
  walletId  String
  wallet    Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String
  taskSlug  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([walletId])
}

/// Points → BCC redemption audit trail (treasury transfer).
model PointRedemption {
  id             String    @id @default(cuid())
  walletId       String
  wallet         Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  pointsSpent    Int
  bccWei         String
  status         String    @default("pending") // pending | credited | failed
  txHash         String?
  idempotencyKey String    @unique
  createdAt      DateTime  @default(now())
  creditedAt     DateTime?

  @@index([walletId])
  @@index([status])
  @@index([createdAt])
}

model TaskDefinition {
  id     String  @id @default(cuid())
  slug   String  @unique
  title  String
  points Int
  active Boolean @default(true)
}

model AirdropCampaign {
  id         String    @id @default(cuid())
  slug       String    @unique
  status     String    @default("draft")
  snapshotAt DateTime?
  merkleRoot String?

  allocations AirdropAllocation[]
}

model AirdropAllocation {
  id             String          @id @default(cuid())
  campaignId     String
  campaign       AirdropCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  walletId       String
  wallet         Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amountWei      String?
  pointsSnapshot Int?

  @@index([campaignId])
  @@index([walletId])
}

/// Append-only activity log (quests, analytics, social, modules).
model ActivityEvent {
  id           String   @id @default(cuid())
  memberId     String?
  member       Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  type         String
  sourceModule String   @default("app")
  payload      Json?
  createdAt    DateTime @default(now())

  @@index([memberId, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
}

/// Outbound Quidli Connect token drops (BCC to social handles).
model QuidliDelivery {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique
  platform       String
  handle         String
  amountWei      String
  tokenAddress   String
  chainId        Int      @default(8453)
  status         String   @default("pending")
  taskSlug       String?
  campaign       String?
  walletId       String?
  wallet         Wallet?  @relation(fields: [walletId], references: [id], onDelete: SetNull)
  memberId       String?
  member         Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  quidliRef      String?
  error          String?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([platform, handle])
  @@index([walletId])
  @@index([campaign])
}

/// Keys, badges, mystery boxes, campaign credits.
model RewardGrant {
  id         String   @id @default(cuid())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  kind       String
  amount     Int      @default(1)
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([memberId])
}

/// Idempotent record of Stripe pack checkout → Culture Points.
model PackPurchase {
  id              String   @id @default(cuid())
  memberId        String
  member          Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  walletId        String
  packSlug        String
  usdCents        Int
  pointsGranted   Int
  stripeSessionId String   @unique
  createdAt       DateTime @default(now())

  @@index([memberId])
  @@index([walletId])
}

/// Stripe pack purchase → BCC settlement obligation (treasury buys/mints BCC + 11.11% bonus).
model BccSettlement {
  id              String    @id @default(cuid())
  memberId        String
  member          Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  walletId        String
  packSlug        String?
  stripeSessionId String?   @unique
  usdCents        Int
  /// Target BCC wei to credit (base purchase equivalent at quote time).
  bccOwedWei      String
  /// Extra BCC wei from 11.11% pack benefit.
  bonusBccWei     String
  status          String    @default("pending")
  note            String?
  createdAt       DateTime  @default(now())
  creditedAt      DateTime?

  @@index([memberId])
  @@index([status])
}

/// Hidden-track Panic Switch riddle claim + voucher NFT mint status.
model PanicVoucherClaim {
  id                  String    @id @default(cuid())
  memberId            String
  member              Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  walletId            String
  wallet              Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  dayUTC              String
  sessionIdHash       String    @unique
  clueFingerprintHash String
  riddleAnswerHash    String
  claimDigest         String    @unique
  precisionScore      Int
  status              String    @default("pending")
  chainId             Int?
  contractAddress     String?
  txHash              String?
  tokenId             String?
  createdAt           DateTime  @default(now())
  mintedAt            DateTime?

  @@unique([walletId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

/// Ingested social post (Farcaster, X, Meta, TikTok, or native curator).
model SocialFeedItem {
  id           String   @id @default(cuid())
  platform     String
  externalId   String?
  authorHandle String?
  authorName   String?
  content      String
  mediaUrls    Json?
  permalink    String?
  metrics      Json?
  publishedAt  DateTime
  ingestedAt   DateTime @default(now())
  featured     Boolean  @default(false)
  comments     SocialComment[]

  @@unique([platform, externalId])
  @@index([publishedAt(sort: Desc)])
  @@index([platform, publishedAt(sort: Desc)])
}

/// Platform-native comment on a feed item (SIWE-gated).
model SocialComment {
  id         String   @id @default(cuid())
  feedItemId String
  feedItem   SocialFeedItem @relation(fields: [feedItemId], references: [id], onDelete: Cascade)
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  body       String
  createdAt  DateTime @default(now())
  hidden     Boolean  @default(false)

  @@index([feedItemId, createdAt(sort: Desc)])
}

/// Point-in-time growth metrics for transparency dashboard.
model GrowthSnapshot {
  id             String   @id @default(cuid())
  capturedAt     DateTime @default(now())
  memberCount    Int
  waitlistCount  Int
  culturePoints  Int
  activity24h    Int
  farcasterItems Int
  xItems         Int
  facebookItems  Int      @default(0)
  tiktokItems    Int      @default(0)
  instagramItems Int      @default(0)
  nativeComments Int
  digest         String

  @@index([capturedAt(sort: Desc)])
}

/// Record of daily on-chain attestation tx.
model PulseAttestation {
  id          String   @id @default(cuid())
  dayId       String   @unique
  digest      String
  metadataUri String
  chainId     Int
  txHash      String
  blockNumber Int?
  createdAt   DateTime @default(now())
}

/// Landing waitlist until member converts.
model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String?
  source    String?
  createdAt DateTime @default(now())
}

/// Append-only log for @bc/agent-runtime ticks (ops + on-chain intents).
model AgentActionLog {
  id        String   @id
  agentId   String
  createdAt DateTime @default(now())
  action    String
  params    Json?
  dryRun    Boolean  @default(false)
  txHash    String?
  status    String
  errorMsg  String?
  costUsd   String?

  @@index([agentId, createdAt(sort: Desc)])
  @@index([createdAt])
}

/// CEO-orchestrated work queue for autonomous agent tasks.
model AgentTask {
  id              String        @id @default(cuid())
  type            String
  payload         Json?
  priority        Int           @default(0)
  status          String        @default("pending")
  assignedAgentId String?
  budgetUsdCap    String?
  createdBy       String        @default("ceo-orchestrator-0")
  outcomeId       String?
  errorMsg        String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  outcome         AgentOutcome? @relation(fields: [outcomeId], references: [id])

  @@index([status, priority(sort: Desc), createdAt])
  @@index([assignedAgentId])
}

/// Measured outcomes for agent learning loops.
model AgentOutcome {
  id           String      @id @default(cuid())
  actionLogIds Json        @default("[]")
  kpiSnapshot  Json?
  rewardScore  Float?
  learnings    String?
  periodStart  DateTime?
  periodEnd    DateTime?
  createdAt    DateTime    @default(now())
  tasks        AgentTask[]

  @@index([createdAt(sort: Desc)])
}

/// Per-agent daily spend tracking (API, gas, deploy).
model AgentDailySpend {
  id        String   @id @default(cuid())
  agentId   String
  spendDate String
  apiUsd    String   @default("0")
  gasEth    String   @default("0")
  deployUsd String   @default("0")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentId, spendDate])
  @@index([spendDate])
}

/// Versioned system prompts for agent learning.
model AgentPromptVersion {
  id           String   @id @default(cuid())
  agentId      String
  version      Int
  systemPrompt String
  active       Boolean  @default(false)
  rewardScore  Float?
  createdAt    DateTime @default(now())

  @@unique([agentId, version])
  @@index([agentId, active])
}

/// Unified corpus chunks for CEO, Grove, and Elias RAG.
model AgentCorpusChunk {
  id        String   @id @default(cuid())
  source    String
  title     String?
  content   String
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([source])
}

/// Ingested AgentShareCampaign `Minted` logs (server-side indexer).
model ChainMintEvent {
  id              String   @id @default(cuid())
  chainId         Int
  contractAddress String
  blockNumber     BigInt
  txHash          String
  logIndex        Int
  toAddress       String
  tokenId         String
  agentTypeId     Int?
  referrer        String?
  createdAt       DateTime @default(now())

  @@unique([chainId, txHash, logIndex])
  @@index([contractAddress, blockNumber])
  @@index([toAddress])
}

/// AI Explorer — cached human-friendly transaction explanation (immutable once confirmed).
model TxExplanation {
  id          String   @id @default(cuid())
  chainId     Int
  txHash      String
  facts       Json
  explanation Json
  model       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([chainId, txHash])
  @@index([createdAt])
}

/// BC Studio — community builder project (Lovable-style).
model StudioProject {
  id                 String   @id @default(cuid())
  memberId           String
  member             Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  slug               String
  displayName        String
  framework          String   @default("vite-react")
  status             String   @default("draft") // draft | preview | live
  sandboxPort        Int?
  sandboxContainerId String?
  previewUrl         String?
  publishedUrl       String?
  createOsProjectId  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  files    StudioFile[]
  messages StudioMessage[]
  usages   StudioUsage[]

  @@unique([memberId, slug])
  @@index([memberId, updatedAt(sort: Desc)])
  @@index([status])
}

model StudioFile {
  id        String   @id @default(cuid())
  projectId String
  project   StudioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  path      String
  content   String   @db.Text
  revision  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, path])
  @@index([projectId])
}

model StudioMessage {
  id        String   @id @default(cuid())
  projectId String
  project   StudioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role      String   // user | assistant | system
  content   String   @db.Text
  toolCalls Json?
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

/// Generations and deploys debited against member credits.
model StudioUsage {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  projectId String?
  project   StudioProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  kind      String   // generation | deploy
  credits   Int      @default(0)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([memberId, createdAt(sort: Desc)])
  @@index([projectId])
}

// ─── Growth Intelligence (multi-tenant product analytics) ───

/// Monitored Building Culture application (tenant).
model GrowthApp {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  domain    String?
  tier      String   @default("free") // free | pro | business | enterprise
  apiKeyHash String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions         GrowthSession[]
  events           GrowthEvent[]
  funnels          GrowthFunnel[]
  insights         GrowthInsight[]
  recommendations  GrowthRecommendation[]
}

model GrowthSession {
  id            String   @id @default(cuid())
  appId         String
  app           GrowthApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  anonymousId   String
  memberId      String?
  member        Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  walletAddress String?
  userAgent     String?
  ipHash        String?
  startedAt     DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  endedAt       DateTime?

  events GrowthEvent[]

  @@index([appId, startedAt(sort: Desc)])
  @@index([anonymousId])
  @@index([memberId])
}

model GrowthEvent {
  id          String   @id @default(cuid())
  appId       String
  app         GrowthApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  sessionId   String
  session     GrowthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind        String
  pathname    String
  selector    String?
  x           Int?
  y           Int?
  scrollDepth Int?
  viewportW   Int?
  viewportH   Int?
  meta        Json?
  occurredAt  DateTime @default(now())

  @@index([appId, occurredAt(sort: Desc)])
  @@index([sessionId, occurredAt])
  @@index([kind, occurredAt(sort: Desc)])
  @@index([pathname])
}

model GrowthFunnel {
  id        String   @id @default(cuid())
  appId     String
  app       GrowthApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  name      String
  steps     Json     // [{ id, label, eventKind, pathname? }]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appId])
}

model GrowthInsight {
  id        String   @id @default(cuid())
  appId     String
  app       GrowthApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  kind      String   // daily | weekly
  dayId     String
  title     String
  body      String   @db.Text
  severity  String   @default("info")
  metrics   Json?
  createdAt DateTime @default(now())

  @@unique([appId, kind, dayId, title])
  @@index([appId, dayId(sort: Desc)])
}

model GrowthRecommendation {
  id             String   @id @default(cuid())
  appId          String
  app            GrowthApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  problem        String   @db.Text
  rootCause      String   @db.Text
  solution       String   @db.Text
  impactEstimate String?
  effort         String   @default("medium")
  priority       String   @default("medium")
  status         String   @default("open")
  dayId          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([appId, status, priority])
  @@index([appId, createdAt(sort: Desc)])
}

/// Builder Voice — structured product feedback with quality scoring and rewards.
model ProductFeedback {
  id            String    @id @default(cuid())
  memberId      String
  member        Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  source        String    // web | telegram
  area          String    // onboarding | marketplace | places | tg | identity | other
  triedWhat     String    @db.Text
  problem       String    @db.Text
  suggestion    String?   @db.Text
  evidenceUrl   String?
  pagePath      String?
  qualityScore  Int       @default(0)
  status        String    @default("rejected") // rejected | pending_review | useful | gold | implemented
  rejectReason  String?
  pointsGranted Int       @default(0)
  publicTitle   String?
  showOnWall    Boolean   @default(false)
  weekBucket    String?
  reviewedAt    DateTime?
  reviewedBy    String?
  createdAt     DateTime  @default(now())

  @@unique([memberId, weekBucket])
  @@index([memberId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([showOnWall, status])
}

// --- Trust layer (Culture ID → Credentials → Reputation → Access) ---

model CultureIdentity {
  id            String   @id @default(cuid())
  memberId      String?  @unique
  member        Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  handle        String   @unique
  ownerAddress  String
  tokenId       String?
  chainId       Int      @default(8453)
  mintedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  linkedWallets     LinkedWallet[]
  userCredentials   UserCredential[]
  reputationEvents  ReputationEvent[]

  @@index([ownerAddress])
}

model LinkedWallet {
  id         String          @id @default(cuid())
  identityId String
  identity   CultureIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  chain      String
  address    String
  verified   Boolean         @default(false)
  verifiedAt DateTime?
  isPrimary  Boolean         @default(false)
  source     String          @default("siwe")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([chain, address])
  @@index([identityId])
}

model XrplLinkChallenge {
  id         String    @id @default(cuid())
  identityId String
  handle     String
  nonce      String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([identityId])
  @@index([expiresAt])
}

model CredentialIssuer {
  id            String       @id @default(cuid())
  slug          String       @unique
  name          String
  did           String?
  walletAddress String?
  verified      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  credentials Credential[]
}

model Credential {
  id             String           @id @default(cuid())
  slug           String           @unique
  name           String
  description    String           @db.Text
  category       String
  issuerId       String
  issuer         CredentialIssuer @relation(fields: [issuerId], references: [id], onDelete: Cascade)
  metadataSchema Json             @default("{}")
  earnRules      Json             @default("{}")
  unlocks        Json             @default("[]")
  xrplMapping    Json?
  tier           Int              @default(1)
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  userCredentials UserCredential[]
}

model UserCredential {
  id                String           @id @default(cuid())
  credentialId      String
  credential        Credential       @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  identityId        String?
  identity          CultureIdentity? @relation(fields: [identityId], references: [id], onDelete: SetNull)
  agentIdentityId   String?
  agentIdentity     AgentIdentity?   @relation(fields: [agentIdentityId], references: [id], onDelete: SetNull)
  memberId          String?
  member            Member?          @relation(fields: [memberId], references: [id], onDelete: SetNull)
  status            String           @default("active")
  evidence          Json             @default("{}")
  issuedAt          DateTime         @default(now())
  expiresAt         DateTime?
  revokedAt         DateTime?
  xrplCredentialHash String?

  @@unique([credentialId, identityId])
  @@index([memberId])
  @@index([identityId])
  @@index([status])
}

model ReputationEvent {
  id         String          @id @default(cuid())
  identityId String
  identity   CultureIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  type       String
  weight     Float           @default(1)
  source     String
  proofRef   String?
  metadata   Json?
  createdAt  DateTime        @default(now())

  @@index([identityId, createdAt(sort: Desc)])
  @@index([type])
}

model AccessRule {
  id                      String   @id @default(cuid())
  slug                    String   @unique
  resourceType            String
  resourceId              String
  minReputation           Float?
  requiredCredentialSlugs String[]
  description             String   @db.Text
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model AgentIdentity {
  id                String           @id @default(cuid())
  slug              String           @unique
  name              String
  walletAddress     String
  chainId           Int              @default(8453)
  agentCardUrl      String?
  cultureIdentityId String?
  status            String           @default("active")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  userCredentials UserCredential[]
}

model ReputationLeaderboardSnapshot {
  id         String   @id @default(cuid())
  handle     String
  score      Float
  rank       Int
  snapshotAt DateTime @default(now())

  @@index([snapshotAt(sort: Desc)])
  @@index([rank])
}

// --- BCID v1 (parallel identity standard) ---

model BcidIdentity {
  id            String   @id @default(cuid())
  did           String   @unique
  type          String   @default("human")
  memberId      String?  @unique
  member        Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  ownerAddress  String
  publicHandle  String?  @unique
  tokenId       String?
  chainId       Int      @default(84532)
  displayName   String?
  metadataUri   String?
  mintedAt      DateTime?
  ownerBcidId   String?
  ownerBcid     BcidIdentity?  @relation("BcidOwnership", fields: [ownerBcidId], references: [id], onDelete: SetNull)
  ownedBcids    BcidIdentity[] @relation("BcidOwnership")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  linkedAccounts    BcidLinkedAccount[]
  bridgeLink        BcidBridgeLink?
  credentials       BcidCredential[]
  reputationEvents  BcidReputationEvent[]
  reputationScores  BcidReputationScore?
  recoveryGuardians BcidRecoveryGuardian[]
  encryptedBlobs    BcidEncryptedBlob[]

  @@index([ownerAddress])
  @@index([type])
}

model BcidLinkedAccount {
  id             String       @id @default(cuid())
  bcidIdentityId String
  bcidIdentity   BcidIdentity @relation(fields: [bcidIdentityId], references: [id], onDelete: Cascade)
  platform       String
  externalId     String?
  handle         String?
  verified       Boolean      @default(false)
  verifiedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([bcidIdentityId, platform])
  @@index([platform, handle])
}

model BcidBridgeLink {
  id               String       @id @default(cuid())
  bcidIdentityId   String       @unique
  bcidIdentity     BcidIdentity @relation(fields: [bcidIdentityId], references: [id], onDelete: Cascade)
  cultureHandle    String       @unique
  cultureTokenId   String
  cultureChainId   Int          @default(8453)
  bridgedAt        DateTime     @default(now())
  contributionSeed Float        @default(0)
}

model BcidCredential {
  id                String       @id @default(cuid())
  bcidIdentityId    String
  bcidIdentity      BcidIdentity @relation(fields: [bcidIdentityId], references: [id], onDelete: Cascade)
  slug              String
  status            String       @default("active")
  evidence          Json         @default("{}")
  easAttestationUid String?
  onchainTokenId    String?
  issuedAt          DateTime     @default(now())
  expiresAt         DateTime?
  revokedAt         DateTime?

  @@unique([bcidIdentityId, slug])
  @@index([slug])
}

model BcidReputationScore {
  id             String       @id @default(cuid())
  bcidIdentityId String       @unique
  bcidIdentity   BcidIdentity @relation(fields: [bcidIdentityId], references: [id], onDelete: Cascade)
  builder        Float        @default(0)
  trust          Float        @default(0)
  contribution   Float        @default(0)
  verification   Float        @default(0)
  updatedAt      DateTime     @updatedAt
}

model BcidReputationEvent {
  id             String       @id @default(cuid())
  bcidIdentityId String
  bcidIdentity   BcidIdentity @relation(fields: [bcidIdentityId], references: [id], onDelete: Cascade)
  scoreType      String
  delta          Float
  source         String
  proofRef       String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([bcidIdentityId, createdAt(sort: Desc)])
  @@index([scoreType])
}

model BcidRecoveryGuardian {
  id              String       @id @default(cuid())
  bcidIdentityId  String
  bcidIdentity    BcidIdentity @relation(fields: [bcidIdentityId], references: [id], onDelete: Cascade)
  guardianAddress String
  approvedAt      DateTime?
  createdAt       DateTime     @default(now())

  @@unique([bcidIdentityId, guardianAddress])
}

model BcidEncryptedBlob {
  id              String       @id @default(cuid())
  bcidIdentityId  String
  bcidIdentity    BcidIdentity @relation(fields: [bcidIdentityId], references: [id], onDelete: Cascade)
  purpose         String
  storageProvider String
  cid             String
  contentHash     String
  schemaVersion   String       @default("1")
  createdAt       DateTime     @default(now())

  @@index([bcidIdentityId])
}

model BcidLeaderboardSnapshot {
  id           String   @id @default(cuid())
  did          String
  publicHandle String?
  builderScore Float
  rank         Int
  snapshotAt   DateTime @default(now())

  @@index([snapshotAt(sort: Desc)])
  @@index([rank])
}

model BcidWaitlistInvite {
  id           String    @id @default(cuid())
  email        String    @unique
  inviteCode   String    @unique
  referralCode String?
  convertedAt  DateTime?
  bcidDid      String?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
}

// --- Outreach CRM (human-approved agent drafts) ---

model OutreachTarget {
  id            String   @id @default(cuid())
  name          String
  segment       String
  channel       String   @default("email")
  contactEmail  String?
  contactUrl    String?
  status        String   @default("prospect")
  notes         String?
  grantProofUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  touches       OutreachTouch[]

  @@index([segment])
  @@index([status])
}

model OutreachTouch {
  id               String         @id @default(cuid())
  targetId         String
  target           OutreachTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  channel          String         @default("email")
  status           String         @default("draft")
  emailSubject     String?
  emailBody        String?        @db.Text
  forumPost        String?        @db.Text
  followUpVariants Json?
  grantProofUrl    String?
  sentAt           DateTime?
  sentBy           String?
  resendId         String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([targetId])
  @@index([status])
}

/// Member agent inbox — email-like threads (draft → review → act).
model AgentInboxThread {
  id           String             @id @default(cuid())
  memberId     String?
  walletAddress String            @db.VarChar(42)
  subject      String
  agentKind    String             @default("research")
  status       String             @default("draft")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  messages     AgentInboxMessage[]

  @@index([walletAddress])
  @@index([status])
}

model AgentInboxMessage {
  id        String           @id @default(cuid())
  threadId  String
  thread    AgentInboxThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String           @default("user")
  body      String           @db.Text
  draftJson Json?
  createdAt DateTime         @default(now())

  @@index([threadId])
}

/// Whale brand storytelling quests (7M+ BCC creators).
model BrandStoryQuest {
  id              String   @id @default(cuid())
  creatorWallet   String   @db.VarChar(42)
  title           String
  storyMarkdown   String   @db.Text
  rewardPoints    Int      @default(100)
  ticketPackSlug  String?
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  participants    BrandStoryQuestParticipant[]

  @@index([creatorWallet])
  @@index([status])
}

model BrandStoryQuestParticipant {
  id        String          @id @default(cuid())
  questId   String
  quest     BrandStoryQuest @relation(fields: [questId], references: [id], onDelete: Cascade)
  wallet    String          @db.VarChar(42)
  completed Boolean         @default(false)
  createdAt DateTime        @default(now())

  @@unique([questId, wallet])
  @@index([wallet])
}

/// Unified culture memory timeline for legacy dashboard.
model CultureMemoryEvent {
  id        String   @id @default(cuid())
  memberId  String?
  wallet    String?  @db.VarChar(42)
  type      String
  payload   Json     @default("{}")
  agentRef  String?
  questId   String?
  txHash    String?
  createdAt DateTime @default(now())

  @@index([memberId, createdAt(sort: Desc)])
  @@index([wallet, createdAt(sort: Desc)])
  @@index([type])
}

/// Marketplace service orders — x402 USDC kickoff + milestone fulfillment.
model ServiceOrder {
  id         String             @id @default(cuid())
  slug       String
  wallet     String             @db.VarChar(42)
  status     String             @default("pending_payment")
  brief      Json               @default("{}")
  x402TxHash String?
  amountUsdc String
  threadId   String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  milestones ServiceMilestone[]

  @@index([wallet])
  @@index([slug])
  @@index([status])
}

model ServiceMilestone {
  id          String       @id @default(cuid())
  orderId     String
  order       ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  index       Int
  title       String
  status      String       @default("pending")
  agentTaskId String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([orderId, index])
  @@index([orderId])
  @@index([status])
}

/// Culture ID referral codes — launch + per-minter 7-code batches.
model IdentityReferralCode {
  id          String    @id @default(cuid())
  code        String    @unique
  ownerWallet String    @db.VarChar(42)
  batchIndex  Int       @default(0)
  status      String    @default("active")
  consumedBy  String?   @db.VarChar(42)
  consumedAt  DateTime?
  mintHandle  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([ownerWallet])
  @@index([status])
}

model IdentityReferralRedemption {
  id         String   @id @default(cuid())
  wallet     String   @unique @db.VarChar(42)
  code       String
  codeId     String?
  mintHandle String
  tokenId    Int?
  createdAt  DateTime @default(now())

  @@index([code])
}

/// Culture Power — maintenance-driven farming quotient for BCC weekly claims.
model MemberPowerState {
  id              String    @id @default(cuid())
  memberId        String    @unique
  powerScore      Int       @default(400)
  peakScore7d     Int       @default(400)
  streakDays      Int       @default(0)
  lastMaintenance DateTime?
  lastComputedAt  DateTime  @default(now())
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model MemberPowerProof {
  id         String    @id @default(cuid())
  memberId   String
  kind       String
  proofRef   String
  amountWei  String?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, kind])
}

/// Culture merch drops — limited-edition tees with ladder pricing.
model MerchDrop {
  slug                String       @id
  title               String
  imageUrl            String
  editionCap          Int          @default(77)
  soldCount           Int          @default(0)
  productionTargetUsd Decimal      @db.Decimal(10, 2)
  status              String       @default("open")
  fundedAt            DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  orders              MerchOrder[]

  @@index([status])
}

model MerchOrder {
  id              String    @id @default(cuid())
  dropSlug        String
  drop            MerchDrop @relation(fields: [dropSlug], references: [slug], onDelete: Cascade)
  unitNumber      Int
  size            String
  wallet          String    @db.VarChar(42)
  priceUsd        Decimal   @db.Decimal(10, 2)
  paymentRail     String
  stripeSessionId String?
  x402TxHash      String?
  claimCode       String    @unique
  shipping        Json
  revenueSplit    Json?
  status          String    @default("pending_payment")
  reservedUntil   DateTime?
  claimedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([dropSlug, unitNumber])
  @@index([wallet])
  @@index([dropSlug, status])
  @@index([claimCode])
  @@index([status, reservedUntil])
}
