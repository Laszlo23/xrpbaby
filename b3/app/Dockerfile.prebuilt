# Production image from a local `npm run build` in app/ (avoids heavy Vite build on small VPS).
FROM node:22-bookworm-slim AS runner
WORKDIR /app

LABEL org.opencontainers.image.title="Building Culture App (prebuilt)"

RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY app/package.json ./package.json
COPY app/node_modules ./node_modules
COPY app/dist ./dist
COPY app/prisma ./prisma
COPY app/scripts/docker-entrypoint.sh ./docker-entrypoint.sh
COPY app/scripts/serve-production.mjs ./scripts/serve-production.mjs

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

ENTRYPOINT ["./docker-entrypoint.sh"]
CMD ["node", "scripts/serve-production.mjs"]
