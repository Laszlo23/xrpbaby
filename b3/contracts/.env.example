# Copy to .env for Foundry deploy scripts — never commit .env
# See ../SECURITY.md

# PRIVATE_KEY=0x...   # deployer — use a dedicated key; fund only for deploys
# RPC_URL=https://mainnet.base.org

# Optional script overrides (see script/*.s.sol)
# BCD_CAP=1000000000000000000000000

# BCC oracle deploy (see ../scripts/deploy-bcc-oracle.sh)
# BCC_TOKEN_ADDRESS=0xb890a5289f789f1346032ccc1847939e855fab07
# BCC_WETH_POOL_ADDRESS=   # Uniswap V3 BCC/WETH pool — omit to deploy MockBccUsdOracle
# ETH_USD_FEED=0x71041dddad35915F74ccc6ae32f57871161a48649
# BCC_WEI_PER_USD_E6=1000000000000000000

# AgentId deploy on 0G Chain mainnet (16661) — see script/DeployAgentId.s.sol
# RPC_URL=https://evmrpc.0g.ai
# AGENT_ID_NAME=BUILDCHAIN Agent ID
# AGENT_ID_SYMBOL=AGENT
# AGENT_ID_BASE_URI=https://app.buildingcultureid.space/0g/agentid/
# AGENT_ID_MINT_TO=0x...
