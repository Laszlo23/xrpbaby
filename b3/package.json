{
  "name": "b3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "overrides": {
    "axios": "1.16.0",
    "@noble/hashes": "1.8.0",
    "vite": "^7.3.1",
    "vitest": {
      "vite": "^7.3.1"
    },
    "@strapi/admin": {
      "axios": "1.16.0",
      "date-fns": "2.30.0"
    },
    "@strapi/plugin-cloud": {
      "@strapi/admin": {
        "axios": "1.16.0"
      }
    }
  },
  "workspaces": [
    "packages/*",
    "app",
    "cms"
  ],
  "scripts": {
    "build": "echo \"Use npm run build --workspace app\"",
    "dev": "npm --prefix app run dev",
    "dev:platform": "bash scripts/dev-platform.sh",
    "dev:local": "bash scripts/dev-local.sh",
    "dev:strapi": "npm --prefix cms run develop",
    "dev:strapi:setup": "npm --prefix cms run bootstrap && npm --prefix cms run ensure:local",
    "dev:full": "bash scripts/dev-full.sh",
    "dev:healthcheck": "node scripts/dev-healthcheck.mjs",
    "studio:orchestrator": "node scripts/studio-orchestrator/index.mjs",
    "db:start": "bash scripts/start-local-db.sh",
    "market:env": "bash scripts/sync-market-env.sh",
    "aerodrome:resolve": "node scripts/resolve-bcc-aerodrome-pool.mjs",
    "aerodrome:seed": "node scripts/seed-bcc-aerodrome-pool.mjs",
    "tg:setup": "bash scripts/setup-telegram-miniapp.sh",
    "mint:premium": "npm --prefix app exec tsx scripts/mint-premium-identities.ts",
    "db:migrate": "cd app && npx prisma migrate deploy",
    "contracts:sdk": "node scripts/sync-contracts-sdk.mjs",
    "contracts:audit": "node scripts/audit-contracts.mjs",
    "alchemy:demo": "npm --prefix alchemy-demo run demo",
    "pulse:ingest": "npm --prefix app run pulse:ingest",
    "pulse:seed": "npm --prefix app run pulse:seed",
    "pulse:attest": "npm --prefix app run pulse:attest",
    "grove:tick": "npm --prefix app run grove:tick",
    "grove:check": "bash scripts/grove-env-check.sh",
    "grove:signer-check": "npm --prefix app run grove:signer-check",
    "grove:launch": "bash scripts/grove-launch-week.sh",
    "setup:agent-0g": "bash scripts/setup-agent-0g.sh",
    "bootstrap:agents": "bash scripts/bootstrap-agents-live.sh",
    "deploy:bootstrap-live": "bash scripts/deploy-bootstrap-live.sh",
    "complete:0g-agent": "node scripts/complete-0g-agent.mjs",
    "probe:og-inference": "node scripts/probe-og-inference.mjs",
    "probe:openai-inference": "node scripts/probe-openai-inference.mjs",
    "deploy:grove": "bash scripts/deploy-grove.sh",
    "deploy:sepolia": "bash scripts/deploy-platform-sepolia.sh",
    "deploy:pulse-mainnet": "PULSE_ATTEST_CHAIN_ID=8453 bash scripts/deploy-pulse-anchor.sh",
    "deploy:bcc-roots": "bash scripts/deploy-bcc-roots-staking.sh",
    "deploy:bcc-oracle": "bash scripts/deploy-bcc-oracle.sh",
    "bcc:sync-addresses": "node scripts/sync-bcc-addresses-doc.mjs && npm run contracts:sdk",
    "reliability:loop": "node scripts/reliability-endpoint-loop.mjs",
    "reliability:install-cron": "bash scripts/install-reliability-cron.sh",
    "test-gate:snapshot": "node scripts/update-test-gate-snapshot.mjs",
    "sync:deploy-env": "bash scripts/sync-deploy-env.sh",
    "deploy:full-stack": "bash scripts/deploy-full-stack.sh",
    "smoke:production": "bash scripts/production-smoke.sh",
    "growth:audit": "bash scripts/growth-audit.sh",
    "resources:audit": "node scripts/resources-audit.mjs",
    "feedback:review": "node app/scripts/review-feedback.mjs",
    "resources:optimize": "node scripts/optimize-images.mjs",
    "resources:optimize-places": "node scripts/optimize-places-public.mjs",
    "lighthouse:ci": "lhci autorun",
    "grant:verify": "bash scripts/grant-verify.sh",
    "grant:proof": "bash scripts/collect-grant-proof.sh",
    "grant:submit-prep": "bash scripts/collect-grant-proof.sh && node scripts/print-grant-submission-fields.mjs",
    "sync:vite-env": "bash scripts/sync-vite-env.sh",
    "audit:vite-env": "node app/scripts/audit-vite-env.mjs",
    "audit:env": "node app/scripts/audit-env.mjs",
    "audit:places-catalog": "node apps/places/scripts/audit-property-catalog.mjs",
    "validate:reoc-metadata": "node apps/places/scripts/validate-reoc-metadata.mjs",
    "places:forge-test": "cd apps/places && forge test",
    "rwa:mainnet-ops": "bash apps/places/scripts/rwa-mainnet-ops.sh",
    "verify:app": "npm --prefix app run verify",
    "verify:frontend": "npm run verify:app",
    "verify:contracts": "cd contracts && forge test && npm run compile",
    "audit:app": "npm --prefix app run audit",
    "test:smoke": "npm --prefix app run test:smoke",
    "test:all": "npm run verify:app && npm run verify:contracts",
    "temporal:dev": "npm --prefix packages/temporal-worker run temporal:dev",
    "temporal:worker": "npm --prefix packages/temporal-worker run worker",
    "temporal:start-workflow": "npm --prefix packages/temporal-worker run start-workflow",
    "bcd-orchestration:build": "npm --prefix packages/bcd-orchestration run build"
  },
  "devDependencies": {
    "@lhci/cli": "^0.14.0",
    "@strapi/plugin-cloud": "^5.44.0",
    "@strapi/plugin-users-permissions": "^5.44.0",
    "@strapi/strapi": "^5.44.0",
    "@types/node": "^22.15.3",
    "date-fns": "^2.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.34.5",
    "styled-components": "^6.4.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^7.3.1"
  }
}
